{
  "realm": "herald",
  "displayName": "Herald (demo identity provider)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "permanentLockout": false,
  "passwordPolicy": "length(12) and notUsername",
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "accessTokenLifespan": 300,
  "roles": {
    "client": {
      "herald": [
        {
          "name": "viewer",
          "description": "Read alerts of own teams"
        },
        {
          "name": "responder",
          "description": "Acknowledge, resolve, run safe runbook steps"
        },
        {
          "name": "editor",
          "description": "Change rules and runbooks of own teams"
        },
        {
          "name": "approver",
          "description": "Approve risky runbook actions"
        },
        {
          "name": "admin",
          "description": "Everything, all teams"
        },
        {
          "name": "team.settlements",
          "description": "Member of team settlements"
        },
        {
          "name": "team.pricing",
          "description": "Member of team pricing"
        },
        {
          "name": "team.rates",
          "description": "Member of team rates"
        },
        {
          "name": "team.counterparty-support",
          "description": "Member of team counterparty-support"
        },
        {
          "name": "team.loadtest",
          "description": "Member of team loadtest"
        }
      ]
    }
  },
  "groups": [
    {
      "name": "Settlements",
      "path": "/Settlements",
      "clientRoles": {
        "herald": [
          "team.settlements",
          "responder"
